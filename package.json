{
  "name": "dsh-deep-dive-skins",
  "description": "Animated blue whale-maid and anime skins for the DSH Web GUI Deep diving status row, with eight continuously rotating actions and cross-version settings support.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skymecode/dsh-deep-diving.git"
  },
  "homepage": "https://github.com/skymecode/dsh-deep-diving#readme",
  "bugs": {
    "url": "https://github.com/skymecode/dsh-deep-diving/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:assets": "node scripts/check-assets.mjs",
    "preview": "pnpm build && vite --host 127.0.0.1 --open /preview/",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.5",
    "@types/semver": "7.7.1",
    "jsdom": "^26.0.0",
    "lightningcss": "1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.7.3",
    "sharp": "0.35.4",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vite": "8.2.1",
    "vitest": "^4.1.1"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets/whale-maid"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "whale",
    "deep-dive",
    "skin",
    "web-ui"
  ]
}
